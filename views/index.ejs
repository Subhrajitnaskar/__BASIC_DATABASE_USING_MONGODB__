<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini watshapp</title>
    <link rel="stylesheet" href="/style.css?v=3">
</head>
<body>
    <h3> All Chats </h3>
    <form method="GET" action="/chats/new">
        <button>New chat</button>
    </form>
    <% for (let chat of chats) { %>
        <div class="chat">
            <p> from: <i><%= chat.from %></i></p> 
            <div class="msg">
                <p><%= chat.msg %></p>
                <form method="GET"action="/chats/<%= chat._id %>/edit">
                    <button>Edit</button>
                </form>
                <br />
                <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE">
                    <button>Delete</button>
                </form>
            </div>
            <p>Received by <i><%= chat.to %></i></p>
            <hr />
            <p><%= chat.created_at.toLocaleTimeString() %></p>
            <p><%= chat.created_at.toLocaleDateString() %></p>
        </div>
        <br /><br />
    <% } %>
</body>
</html>   