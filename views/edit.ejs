<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your Chat</title>
</head>
<body>

    <h2>Edit your Chat</h2>

    <p>Edit your chat: <%= chat._id %></p>

    <p>
        This chat was sent by <%= chat.from %> to <%= chat.to %>
    </p>

    <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">

        <textarea name="msg" rows="6" cols="50" required><%= chat.msg %></textarea>

        <br><br>

        <button type="submit">Update Chat</button>

    </form>

    <br>

    <a href="/chats">Back to Chats</a>

</body>
</html>